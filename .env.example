# Proxmox API connection. The default URL targets this host's local API.
PVE_API=https://127.0.0.1:8006/api2/json
PVE_NODE=kamilsServer
# Format: user@realm!tokenid=secret
PVE_API_TOKEN=proxmoxcontroller@pve!dashboard=REPLACE_WITH_TOKEN_SECRET
PVE_CA_CERT=/etc/pve/pve-root-ca.pem
PVE_TLS_VERIFY=true

# Login for this web dashboard (choose a long, unique password).
APP_USER=admin
APP_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Optional: set a separate random cookie-signing key (openssl rand -hex 32).
# If empty, APP_PASSWORD is used to sign login sessions.
APP_SESSION_SECRET=

# File browser limits, in bytes per file.
MAX_VM_FILE_BYTES=8388608
MAX_CT_FILE_BYTES=536870912
HOST=0.0.0.0
PORT=8787
